 "doctype": "Print Format",
 "font_size": 0,
 "html": "<div class=\"si-print\">\n<style>\n    .si-print { font-family: \"Helvetica Neue\", Arial, sans-serif; font-size: 9pt; color: #1f272e; }\n    .si-print .si-head { text-align: center; border-bottom: 2px solid #2b3a8c; padding-bottom: 8px; margin-bottom: 12px; }\n    .si-print .si-head .co { font-size: 16pt; font-weight: 700; color: #1f272e; }\n    .si-print .si-head .ln { font-size: 8pt; color: #4c5a67; }\n    .si-print .si-head .doc { font-size: 11pt; font-weight: 700; letter-spacing: 1px; color: #2b3a8c; margin-top: 4px; }\n    .si-print table { width: 100%; border-collapse: collapse; }\n    .si-print .si-meta td { border: none; padding: 2px 6px; vertical-align: top; }\n    .si-print .lbl { font-size: 7pt; letter-spacing: 0.5px; text-transform: uppercase; color: #8a94a6; display: block; }\n    .si-print .val { font-size: 10pt; }\n    .si-print .si-box { border: 1px solid #e3e7ee; padding: 8px 10px; margin-bottom: 12px; }\n    .si-print .si-items th { background: #f4f5f8; color: #5b6b7d; font-weight: 600; font-size: 8pt; text-transform: uppercase; letter-spacing: 0.4px; padding: 7px 10px; text-align: left; border-bottom: 1px solid #e3e7ee; }\n    .si-print .si-items td { padding: 7px 10px; border-bottom: 1px solid #f0f2f5; vertical-align: top; }\n    .si-print .num { text-align: right; }\n    .si-print .si-totals { width: 45%; margin-left: 55%; margin-top: 8px; }\n    .si-print .si-totals td { padding: 4px 10px; }\n    .si-print .si-totals .grand td { border-top: 2px solid #2b3a8c; font-weight: 700; font-size: 11pt; color: #2b3a8c; }\n    .si-print .si-totals .out td { color: #c0392b; font-weight: 700; }\n    .si-print .si-words { background: #f7f8fa; border-left: 3px solid #2b3a8c; padding: 8px 12px; margin-top: 12px; }\n    .si-print .si-foot { margin-top: 16px; font-size: 8pt; color: #8a94a6; text-align: center; }\n</style>\n\n<div class=\"si-head\">\n    <div class=\"co\">Fanaka Real Estate Ltd</div>\n    <div class=\"ln\">Dune Plaza, Ruai Town | P.O. Box 252-00222, Nairobi</div>\n    <div class=\"ln\">Tel: 0799 000 111 | Email: info@fanaka.co.ke</div>\n    <div class=\"doc\">INVOICE</div>\n</div>\n\n<table class=\"si-meta\" style=\"margin-bottom:12px;\">\n    <tr>\n        <td style=\"width:55%;\">\n            <span class=\"lbl\">Bill To</span>\n            <span class=\"val\"><strong>{{ doc.customer_name or doc.customer }}</strong></span><br>\n            {% if doc.contact_mobile %}<span class=\"val\">{{ doc.contact_mobile }}</span><br>{% endif %}\n            {% if doc.tax_id %}<span class=\"lbl\" style=\"display:inline;\">KRA PIN:</span> {{ doc.tax_id }}{% endif %}\n        </td>\n        <td style=\"width:45%;\">\n            <table style=\"width:100%;\">\n                <tr><td><span class=\"lbl\">Invoice No</span><span class=\"val\">{{ doc.name }}</span></td></tr>\n                <tr><td><span class=\"lbl\">Invoice Date</span><span class=\"val\">{{ doc.get_formatted(\"posting_date\") }}</span></td></tr>\n                <tr><td><span class=\"lbl\">Due Date</span><span class=\"val\">{{ doc.get_formatted(\"due_date\") }}</span></td></tr>\n            </table>\n        </td>\n    </tr>\n</table>\n\n<table class=\"si-items\">\n    <thead>\n        <tr>\n            <th style=\"width:36px;\">SR</th>\n            <th>Item / Description</th>\n            <th class=\"num\" style=\"width:50px;\">Qty</th>\n            <th class=\"num\" style=\"width:110px;\">Rate</th>\n            <th class=\"num\" style=\"width:120px;\">Amount</th>\n        </tr>\n    </thead>\n    <tbody>\n    {% for row in doc.items %}\n        <tr>\n            <td>{{ loop.index }}</td>\n            <td>\n                <strong>{{ row.item_name }}</strong>\n                {% if row.custom_plot %}<br><span class=\"lbl\" style=\"display:inline;\">Plot:</span> {{ row.custom_plot }}{% endif %}\n                {% if row.description and row.description != row.item_name %}<br><small>{{ row.description | striptags }}</small>{% endif %}\n            </td>\n            <td class=\"num\">{{ row.qty }}</td>\n            <td class=\"num\">{{ row.get_formatted(\"rate\") }}</td>\n            <td class=\"num\">{{ row.get_formatted(\"amount\") }}</td>\n        </tr>\n    {% endfor %}\n    </tbody>\n</table>\n\n<table class=\"si-totals\">\n    <tr><td>Net Total</td><td class=\"num\">{{ doc.get_formatted(\"net_total\") }}</td></tr>\n    {% if doc.total_taxes_and_charges %}\n    <tr><td>Taxes &amp; Charges</td><td class=\"num\">{{ doc.get_formatted(\"total_taxes_and_charges\") }}</td></tr>\n    {% endif %}\n    {% if doc.discount_amount %}\n    <tr><td>Discount</td><td class=\"num\">- {{ doc.get_formatted(\"discount_amount\") }}</td></tr>\n    {% endif %}\n    <tr class=\"grand\"><td>Grand Total</td><td class=\"num\">{{ doc.get_formatted(\"rounded_total\") or doc.get_formatted(\"grand_total\") }}</td></tr>\n    {% if doc.total_advance %}\n    <tr><td>Paid</td><td class=\"num\">{{ doc.get_formatted(\"total_advance\") }}</td></tr>\n    {% endif %}\n    <tr class=\"out\"><td>Outstanding</td><td class=\"num\">{{ doc.get_formatted(\"outstanding_amount\") }}</td></tr>\n</table>\n\n{% if doc.in_words %}\n<div class=\"si-words\">\n    <span class=\"lbl\">Amount in Words</span>\n    <div class=\"val\">{{ doc.in_words }}</div>\n</div>\n{% endif %}\n\n{% if doc.remarks %}\n<div class=\"si-box\" style=\"margin-top:12px;\">\n    <span class=\"lbl\">Remarks</span>\n    <div>{{ doc.remarks }}</div>\n</div>\n{% endif %}\n\n<div class=\"si-foot\">This is a computer generated invoice.</div>\n\n</div>\n",
