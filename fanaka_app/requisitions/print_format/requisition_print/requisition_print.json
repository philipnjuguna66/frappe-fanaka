 "doctype": "Print Format",
 "font_size": 0,
 "html": "<div class=\"requisition-print\">\n<style>\n    .requisition-print { font-family: sans-serif; font-size: 9pt; color: #111; }\n    .requisition-print .req-header { width: 100%; border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 12px; }\n    .requisition-print .req-header table { width: 100%; border: none; margin: 0; }\n    .requisition-print .req-header td { border: none; vertical-align: middle; padding: 0; }\n    .requisition-print .req-header img { height: 64px; width: auto; }\n    .requisition-print .req-header .company { font-size: 16pt; font-weight: bold; }\n    .requisition-print .req-header .doc-title { font-size: 12pt; color: #444; }\n    .requisition-print h2 { margin: 0 0 4px 0; font-size: 14pt; }\n    .requisition-print table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }\n    .requisition-print th, .requisition-print td { border: 1px solid #999; padding: 4px 6px; text-align: left; vertical-align: top; }\n    .requisition-print th { background: #f2f2f2; }\n    .requisition-print .meta td { border: none; padding: 2px 6px; }\n    .requisition-print .num { text-align: right; }\n    .requisition-print .att { margin-top: 6px; page-break-inside: avoid; }\n    .requisition-print .att img { max-width: 100%; max-height: 520px; border: 1px solid #ccc; padding: 2px; }\n    .requisition-print .section-title { font-weight: bold; margin: 12px 0 4px 0; font-size: 11pt; border-bottom: 1px solid #000; }\n</style>\n\n<div class=\"req-header\">\n    <table>\n        <tr>\n            <td style=\"width:70%; text-align:left;\">\n                <div class=\"company\">Fanaka Real Estate</div>\n                <div class=\"doc-title\">Payment Requisition</div>\n            </td>\n            <td style=\"width:30%; text-align:right;\">\n                <img src=\"https://mis.fanaka.co.ke/img/fanaka-real_estate_logo.png\" />\n            </td>\n        </tr>\n    </table>\n</div>\n\n<h2>Requisition {{ doc.name }}</h2>\n\n<table class=\"meta\">\n    <tr>\n        <td style=\"width:50%\"><strong>Requested By:</strong> {{ doc.owner_full_name or doc.requisition_owner or \"\" }}</td>\n        <td style=\"width:50%\"><strong>Status:</strong> {{ doc.status or \"\" }}</td>\n    </tr>\n    <tr>\n        <td><strong>Total Amount:</strong> {{ doc.get_formatted(\"total_amount\") }}</td>\n        <td><strong>Date:</strong> {{ doc.get_formatted(\"creation\") }}</td>\n    </tr>\n    {% if doc.initiated_by or doc.authorised_by %}\n    <tr>\n        <td><strong>Initiated By:</strong> {{ doc.initiated_by or \"\" }}</td>\n        <td><strong>Authorised By:</strong> {{ doc.authorised_by or \"\" }}</td>\n    </tr>\n    {% endif %}\n</table>\n\n{% if doc.description %}\n<div class=\"section-title\">Description</div>\n<div>{{ doc.description }}</div>\n{% endif %}\n\n{% if doc.requisition_items %}\n<div class=\"section-title\">Items</div>\n<table>\n    <thead><tr><th>Item</th><th class=\"num\">Subtotal</th></tr></thead>\n    <tbody>\n    {% for row in doc.requisition_items %}\n        <tr><td>{{ row.item_name }}</td><td class=\"num\">{{ row.get_formatted(\"subtotal\") }}</td></tr>\n    {% endfor %}\n    </tbody>\n    <tfoot>\n        <tr><th>Total</th><th class=\"num\">{{ doc.get_formatted(\"total_amount\") }}</th></tr>\n    </tfoot>\n</table>\n{% endif %}\n\n{% if doc.pay_methods %}\n<div class=\"section-title\">Pay Methods</div>\n<table>\n    <thead><tr><th>Method</th><th>Payee Name</th><th>Pay To</th><th>Account Ref</th><th class=\"num\">Amount</th></tr></thead>\n    <tbody>\n    {% for row in doc.pay_methods %}\n        <tr>\n            <td>{{ row.payment_method }}</td>\n            <td>{{ row.payee_name or \"\" }}</td>\n            <td>{{ row.pay_to or \"\" }}</td>\n            <td>{{ row.account_reference or \"\" }}</td>\n            <td class=\"num\">{{ row.get_formatted(\"amount\") }}</td>\n        </tr>\n    {% endfor %}\n    </tbody>\n</table>\n{% else %}\n<div class=\"section-title\">Payment</div>\n<table class=\"meta\">\n    <tr><td><strong>Method:</strong> {{ doc.payment_method or \"\" }}</td><td><strong>Pay To:</strong> {{ doc.pay_to or \"\" }}</td></tr>\n    {% if doc.account_reference %}<tr><td colspan=\"2\"><strong>Account Ref:</strong> {{ doc.account_reference }}</td></tr>{% endif %}\n</table>\n{% endif %}\n\n</div>\n",
 "idx": 0,
